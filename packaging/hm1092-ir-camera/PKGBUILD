# Maintainer: Josua Schmid <josua.schmid@renuo.ch>
#
# The Himax HM1092 is the Windows Hello IR sensor Dell fits next to the IPU7 RGB
# camera, and Linux has no driver for it yet. The sensor module comes from
# jibsta210/svp7500-camera-fix-pack, which streams it on the Dell XPS 16, and
# kernels before 7.3 get an ipu-bridge rebuilt with the sensor's ACPI id, the
# same entry mainline 7.3 carries. The relay turns the raw stream into a
# grayscale V4L2 device for Howdy and owns the IR flood LED. Developed in the
# omarchy-dell-xps-face overlay for Omarchy; intel-ipu7-camera stays in charge
# of the RGB camera and the bridge ownership handshake.

pkgname=hm1092-ir-camera
pkgver=0.1.0
pkgrel=3
pkgdesc="Himax HM1092 Windows Hello IR camera behind Intel IPU7: sensor driver, ipu-bridge entry and grayscale relay for face authentication"
arch=('any')
url="https://github.com/renuo/omarchy-dell-xps-face"
license=('GPL-2.0-only')
depends=('dkms' 'intel-ipu7-camera' 'v4l2loopback-dkms' 'v4l2loopback-utils' 'v4l-utils' 'python' 'python-numpy')
backup=('etc/hm1092-ir-camera.conf')
install="$pkgname.install"

_fixpack=svp7500-camera-fix-pack
_fixpack_ver=1.0.5
_bridge_kver=7.2.5

source=(
  "$_fixpack-$_fixpack_ver.tar.gz::https://github.com/jibsta210/$_fixpack/archive/refs/tags/v$_fixpack_ver.tar.gz"
  "ipu-bridge-$_bridge_kver.c::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/drivers/media/pci/intel/ipu-bridge.c?h=v$_bridge_kver"
  ipu-bridge-hm1092.patch
  hm1092.dkms.conf
  hm1092.Makefile
  ipu-bridge-hm1092.dkms.conf
  ipu-bridge-hm1092.Makefile
  hm1092-relay
  hm1092-ir-led
  hm1092-ir-led-sleep
  hm1092-ir-camera.conf
  hm1092-camera-init.service
  hm1092-relay.service
  hm1092-camera-deps.conf
  72-hm1092-ir-camera.rules
  hide-hm1092-ir-camera.conf
)
