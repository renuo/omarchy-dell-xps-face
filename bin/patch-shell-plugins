#!/usr/bin/python3
"""Generate this overlay's lock and polkit plugins from an Omarchy shell tree.

    bin/patch-shell-plugins <omarchy>/shell <output>/shell

shell/plugins/lock and shell/plugins/polkit here are upstream's files with the
face context and the face offer added at fixed anchors. Running this against
upstream's tree regenerates them after upstream moves. The face's words come
from default/i18n/en/shell.json, like every other string the shell shows.
"""

import pathlib
import re
import sys


def once(s, old, new):
    assert s.count(old) == 1, f"anchor not unique: {old[:60]!r}"
    return s.replace(old, new)


def sub_once(s, pattern, repl):
    out, n = re.subn(pattern, repl, s, count=1, flags=re.M)
    assert n == 1, f"pattern not found: {pattern}"
    return out


FACE_MODEL = '''// The face scans only after the Copilot key, which root reads from the
// keyboard itself (omarchy-face-key); the lock merely keeps a face check
// waiting for it while it offers the face. Nothing scans on lock, wake or a
// timer alone: the IR camera and its invisible flood LED must not run
// without that consent.

// Howdy gives up after its own timeout (4 s by default); this bounds a scan
// whose PAM conversation never completes.
var ATTEMPT_TIMEOUT_MS = 15000

// After a scan that failed, the next check waits this long, so the failure
// stays readable and a failing helper cannot spin.
var REARM_DELAY_MS = 1500

// Lines on the face check's conversation: omarchy-face-match prints the first
// when the key starts a scan, omarchy-face-key the second when another
// program waited for the key at the same time. Howdy tells a face it does not
// know only by running out of time, and pam_exec turns that, like every
// refusal, into a system error, so the helper's third line is what tells a
// stranger from a broken camera.
var SCAN_MESSAGE = "Scanning face\u2026"
var REFUSED_MESSAGE = "Face refused: another program is waiting for the Copilot key too"
var NO_MATCH_MESSAGE = "Face detection timeout reached"

// "Who are you?" stands this long before the field says what is left.
var NO_MATCH_HOLD_MS = 10000

// A lock offers the face for a few scans and for a while after it was taken;
// past either, only the password opens it. /etc/omarchy/face.conf sets both,
// and anything missing or malformed there falls back to these.
var DEFAULT_ATTEMPTS = 1
var DEFAULT_WINDOW_MINUTES = 60

function positiveInteger(value, fallback) {
  return /^[1-9][0-9]{0,5}$/.test(value) ? parseInt(value, 10) : fallback
}

function parsePolicy(text) {
  var policy = { attempts: DEFAULT_ATTEMPTS, windowMs: DEFAULT_WINDOW_MINUTES * 60000 }
  var lines = String(text || "").split("\\n")
  for (var i = 0; i < lines.length; i++) {
    var match = lines[i].match(/^\\s*([A-Z_]+)=("?)([^"]*)\\2\\s*$/)
    if (!match) continue
    if (match[1] === "LOCK_ATTEMPTS") policy.attempts = positiveInteger(match[3], DEFAULT_ATTEMPTS)
    else if (match[1] === "LOCK_WINDOW_MINUTES") policy.windowMs = positiveInteger(match[3], DEFAULT_WINDOW_MINUTES) * 60000
  }
  return policy
}

// A lock of unknown age, or a clock that went backwards, has no window left.
function windowExpired(lockedAtMs, nowMs, policy) {
  if (!(lockedAtMs > 0) || nowMs < lockedAtMs) return true
  return nowMs - lockedAtMs >= policy.windowMs
}

// "" without an enrolled face; otherwise "offered", or why it no longer is.
function faceState(configured, attemptsUsed, expired, policy) {
  if (!configured) return ""
  if (attemptsUsed >= policy.attempts) return "exhausted"
  if (expired) return "expired"
  return "offered"
}

function placeholderText(state, t) {
  if (state === "offered") return t("lock.faceOrPassword")
  if (state === "exhausted") return t("lock.passwordFaceFailed")
  if (state === "expired") return t("lock.passwordFaceExpired")
  return t("lock.enterPassword")
}

// "" while a scan is left, since the placeholder then offers the face again.
function noMatchFollowUp(state, t) {
  return state === "offered" ? "" : t("lock.enterPassword")
}

if (typeof module !== "undefined") {
  module.exports = {
    ATTEMPT_TIMEOUT_MS: ATTEMPT_TIMEOUT_MS,
    REARM_DELAY_MS: REARM_DELAY_MS,
    SCAN_MESSAGE: SCAN_MESSAGE,
    REFUSED_MESSAGE: REFUSED_MESSAGE,
    NO_MATCH_MESSAGE: NO_MATCH_MESSAGE,
    NO_MATCH_HOLD_MS: NO_MATCH_HOLD_MS,
    DEFAULT_ATTEMPTS: DEFAULT_ATTEMPTS,
    DEFAULT_WINDOW_MINUTES: DEFAULT_WINDOW_MINUTES,
    parsePolicy: parsePolicy,
    windowExpired: windowExpired,
    faceState: faceState,
    placeholderText: placeholderText,
    noMatchFollowUp: noMatchFollowUp
  }
}
'''

FACE_FUNCS = '''  // The lock keeps a face check waiting while it offers the face; root scans
  // once the Copilot key is pressed (omarchy-face-key), and the helper's
  // "Scanning face…" line tells the lock that a scan started. Every scan
  // spends one of the lock's attempts. The window since locking is read
  // afresh whenever the offer is checked or a scan starts, since the display
  // may have been dark, or the machine asleep, when it closed.
  function syncFace() {
    refreshFaceWindow()
    if (faceAuthenticating) return
    if (currentFaceState() === "offered") armFace()
    else if (facePam.active) settleFaceAttempt("face-withdrawn: " + (currentFaceState() || "unconfigured"))
  }

  function armFace() {
    if (!lockRequested || !sessionLock.secure || facePam.active) return
    if (!facePam.start()) {
      logEvent("face-start-failed")
      return
    }
    logEvent("face-armed")
  }

  function noteFaceMessage(message) {
    if (message === FaceModel.SCAN_MESSAGE) {
      refreshFaceWindow()
      if (currentFaceState() !== "offered") {
        settleFaceAttempt("face-aborted: " + currentFaceState())
        return
      }
      faceAuthenticating = true
      faceNoMatch = false
      faceAttempts += 1
      failureMessage = ""
      faceNoMatchTimer.stop()
      faceAbortTimer.restart()
      logEvent("face-attempt: " + faceAttempts + "/" + facePolicy.attempts)
      if (displaysBlank) runWake()
    } else if (message === FaceModel.NO_MATCH_MESSAGE) {
      if (faceAuthenticating) faceNoMatch = true
    } else if (message === FaceModel.REFUSED_MESSAGE) {
      failureMessage = I18n.t("lock.faceRefused")
      logEvent("face-refused: another prompt waits for the key")
    }
  }

  function currentFaceState() {
    return FaceModel.faceState(faceConfigured, faceAttempts, faceWindowExpired, facePolicy)
  }

  function refreshFaceWindow() {
    faceWindowExpired = FaceModel.windowExpired(faceLockedAtMs, Date.now(), facePolicy)
  }

  function applyFacePolicy(text) {
    facePolicy = FaceModel.parsePolicy(text)
    syncFace()
  }

  // abort() gives no completion signal; settle the check here.
  function settleFaceAttempt(event, message) {
    faceAbortTimer.stop()
    if (facePam.active) facePam.abort()
    var scanning = faceAuthenticating
    faceAuthenticating = false
    if (event) logEvent(event)
    if (scanning && message && lockRequested) failureMessage = message
  }

  // A check that ends without a scan (its window closed, or the key service
  // was unavailable) is no attempt; the next sync arms it again if it may.
  function handleFaceFinished(result) {
    faceAbortTimer.stop()
    var scanned = faceAuthenticating
    faceAuthenticating = false
    if (!lockRequested) return
    if (!scanned) {
      logEvent("face-check-ended")
      return
    }
    if (result === PamResult.Success) {
      logEvent("face-matched")
      finishUnlock()
      return
    }
    if (result === PamResult.Error) {
      logEvent("face-error")
      failureMessage = I18n.t("lock.faceUnavailable")
    } else {
      logEvent("face-no-match")
      rejectFace()
    }
    faceRearmTimer.restart()
  }

  function handleFaceError() {
    var scanning = faceAuthenticating
    if (!scanning || !faceNoMatch) {
      settleFaceAttempt("face-error", I18n.t("lock.faceUnavailable"))
      return
    }
    settleFaceAttempt("face-no-match")
    rejectFace()
    faceRearmTimer.restart()
  }

  function rejectFace() {
    if (!lockRequested) return
    failureMessage = I18n.t("lock.faceNoMatch")
    faceNoMatchTimer.restart()
  }

  // Typing or a password check may have replaced the question already.
  function followUpNoMatch() {
    if (failureMessage !== I18n.t("lock.faceNoMatch")) return
    refreshFaceWindow()
    failureMessage = FaceModel.noMatchFollowUp(currentFaceState(), I18n.t)
  }

'''

FACE_PAM = '''
  PamContext {
    id: facePam
    config: "omarchy-lock-face"
    user: root.userName

    onPamMessage: root.noteFaceMessage(message)

    onCompleted: function(result) {
      root.handleFaceFinished(result)
    }

    // A completed(Error) follows; settling here keeps the LED off meanwhile.
    onError: function(error) { root.handleFaceError() }
  }
'''

FACE_TIMER = '''  Timer {
    id: faceAbortTimer
    interval: FaceModel.ATTEMPT_TIMEOUT_MS
    repeat: false
    onTriggered: {
      root.settleFaceAttempt("face-timeout", I18n.t("lock.faceUnavailable"))
      root.syncFace()
    }
  }

  Timer {
    id: faceNoMatchTimer
    interval: FaceModel.NO_MATCH_HOLD_MS
    repeat: false
    onTriggered: root.followUpNoMatch()
  }

  Timer {
    id: faceRearmTimer
    interval: FaceModel.REARM_DELAY_MS
    repeat: false
    onTriggered: root.syncFace()
  }

  // Closes the offer when the window since locking runs out while the display
  // stays on, and retries a check that could not start.
  Timer {
    interval: 30000
    repeat: true
    running: root.lockRequested && root.faceConfigured
    onTriggered: root.syncFace()
  }

'''

FACE_FILEVIEW = '''  // The face setup writes this file only after a verified enrollment, and only
  // when the face is wanted on the lock screen; the removal deletes it, so its
  // presence is the signal.
  FileView {
    path: "/etc/pam.d/omarchy-lock-face"
    watchChanges: true
    printErrors: false
    onLoaded: root.faceConfigured = true
    onLoadFailed: root.faceConfigured = false
    onFileChanged: reload()
  }

  // Root's policy for the offer; without the file the strict defaults hold.
  FileView {
    path: "/etc/omarchy/face.conf"
    watchChanges: true
    printErrors: false
    onLoaded: root.applyFacePolicy(text())
    onLoadFailed: root.applyFacePolicy("")
    onFileChanged: reload()
  }

'''

FACE_ICON = '''      // Face hint pinned inside the field's left edge while the lock offers
      // the face; it brightens while a scan runs. The Copilot key starts one,
      // so the placeholder says "Face or Password". Once the lock's
      // scans are spent or its window has closed, the hint goes and the
      // placeholder says why only the password is left.
      Text {
        id: faceIcon
        objectName: "faceIndicator"
        textFormat: Text.PlainText
        anchors.left: parent.left
        anchors.leftMargin: inputField.borderLeft + 18
        anchors.verticalCenter: parent.verticalCenter
        visible: root.faceIconShown
        text: "\uf030"
        color: root.faceAuthenticating ? %(active)s : %(placeholder)s
%(font_lines)s
        horizontalAlignment: Text.AlignHCenter
        verticalAlignment: Text.AlignVCenter
      }

'''

FACE_PAM_CONFIG = '''// Face authentication is offered only in the form that asks first: the helper
// with expose_authtok, which scans only when the Copilot key answered the
// password prompt. A face line without it would scan unasked, and the dialog
// must not invite that.
function faceConfiguredFromPamConfig(raw) {
  var lines = String(raw || "").split("\\n")
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i].replace(/^\\s+|\\s+$/g, "")
    if (!line || line.charAt(0) === "#") continue
    if (!line.match(/^auth\\s+/)) continue
    if (line.indexOf("omarchy-face-match") !== -1 && line.indexOf("expose_authtok") !== -1) return true
  }
  return false
}

'''


FACE_KEY = '''  // The Copilot key, which Hyprland hands to the shell instead of any window
  // (default/hypr/toggles/face-key.lua). The dialog answers the password
  // prompt with nothing; root scans only if omarchy-face-key saw the key on
  // the keyboard itself, so a forged call is merely an empty password.
  function scanFace() {
    var flow = polkitAgent.flow
    if (!faceOffered || !flow || !flow.isResponseRequired) return "ignored"
    passwordInput.text = ""
    scanning = true
    submitted = true
    errorFlash = false
    flow.submit("")
    keyCatcher.forceActiveFocus()
    return "scanning"
  }

  ShellIpc {
    target: "polkit"

    function faceKey(): string {
      return root.scanFace()
    }
  }

'''


def patch_lock(src, dst):
    service = (src / "Service.qml").read_text()
    view = (src / "LockView.qml").read_text()

    lines = service.split("\n")
    last_import = max(i for i, l in enumerate(lines) if l.startswith("import "))
    lines.insert(last_import + 1, 'import "FaceModel.js" as FaceModel')
    service = "\n".join(lines)
    service = once(service, "  property bool fingerprintConfigured: false\n",
        "  property bool fingerprintConfigured: false\n  property bool faceConfigured: false\n  property bool faceAuthenticating: false\n"
        "  property bool faceNoMatch: false\n"
        "  property int faceAttempts: 0\n  property double faceLockedAtMs: 0\n  property bool faceWindowExpired: true\n"
        "  property var facePolicy: FaceModel.parsePolicy(\"\")\n"
        "  readonly property string faceState: FaceModel.faceState(faceConfigured, faceAttempts, faceWindowExpired, facePolicy)\n")
    service = once(service, "readonly property bool authenticating: authenticatingPassword || fingerprintAuthenticating\n",
        "readonly property bool authenticating: authenticatingPassword || fingerprintAuthenticating || faceAuthenticating\n")
    service = once(service, "    if (passwordPam.active) passwordPam.abort()\n    if (fingerprintPam.active) fingerprintPam.abort()\n",
        "    if (passwordPam.active) passwordPam.abort()\n    if (fingerprintPam.active) fingerprintPam.abort()\n"
        "    faceRearmTimer.stop()\n    faceNoMatchTimer.stop()\n    settleFaceAttempt()\n    faceAttempts = 0\n")
    service = once(service, "    resetAuthenticationState()\n    lockRequested = true\n",
        "    resetAuthenticationState()\n    lockRequested = true\n    faceLockedAtMs = Date.now()\n    refreshFaceWindow()\n")
    service = once(service, "    logEvent(\"lock-stranded: recovering\")\n    beginLock()\n",
        "    logEvent(\"lock-stranded: recovering\")\n    beginLock()\n"
        "    // The old shell took this lock's age and spent scans with it.\n"
        "    faceLockedAtMs = 0\n    refreshFaceWindow()\n")
    m = re.search(r"\n  function runWake\(\) \{\n", service)
    assert m
    end = service.index("\n  }\n", m.end())
    service = service[:end] + "\n    syncFace()" + service[end:]
    m = re.search(r"\n  function runBlank\(\) \{\n", service)
    assert m
    end = service.index("\n  }\n", m.end())
    service = service[:end] + ("\n    // The check keeps waiting in the dark; a scan running into the blank stops."
        "\n    if (faceAuthenticating) {\n      settleFaceAttempt(\"face-aborted: blank\")\n      syncFace()\n    }") + service[end:]
    service = once(service, "        root.startFingerprint()\n", "        root.startFingerprint()\n        root.syncFace()\n")
    service = once(service, "  function handleFingerprintFinished(result) {\n", FACE_FUNCS + "  function handleFingerprintFinished(result) {\n")
    service = sub_once(service, r"^(        )fingerprintConfigured: root\.fingerprintConfigured.*\n",
        lambda m: m.group(0) + m.group(1) + "faceState: root.faceState\n" + m.group(1) + "faceAuthenticating: root.faceAuthenticating\n")
    service = sub_once(service, r"^(      )fingerprintConfigured: root\.fingerprintConfigured.*\n",
        lambda m: m.group(0) + m.group(1) + "faceState: root.faceConfigured ? \"offered\" : \"\"\n" + m.group(1) + "faceAuthenticating: false\n")
    i = service.index("    id: fingerprintPam\n")
    end = service.index("\n  }\n", i) + len("\n  }\n")
    service = service[:end] + FACE_PAM + service[end:]
    service = once(service, "  Timer {\n    id: fingerprintRetryTimer\n", FACE_TIMER + "  Timer {\n    id: fingerprintRetryTimer\n")
    service = once(service, '  FileView {\n    path: "/etc/pam.d/omarchy-lock-password"\n', FACE_FILEVIEW + '  FileView {\n    path: "/etc/pam.d/omarchy-lock-password"\n')
    service = once(service, "        fingerprint: root.fingerprintConfigured,\n",
        "        fingerprint: root.fingerprintConfigured,\n        face: root.faceConfigured,\n        faceState: root.faceState,\n"
        "        faceAttempts: root.faceAttempts,\n        faceArmed: facePam.active,\n        faceAuthenticating: root.faceAuthenticating,\n")
    service = once(service, "  function armBlankTimer() {\n",
        "  function armBlankTimer() {\n"
        "    // A face scan holds the display up, since blanking would cut it short\n"
        "    // and spend one of the lock's attempts; its end re-arms the timer.\n"
        "    if (faceAuthenticating) return\n")
    service = once(service,
        "  onAuthenticatingPasswordChanged: {\n    if (!lockRequested) return\n"
        "    if (authenticatingPassword) idleBlankTimer.stop()\n    else armBlankTimer()\n  }\n",
        "  onAuthenticatingPasswordChanged: {\n    if (!lockRequested) return\n"
        "    if (authenticatingPassword) idleBlankTimer.stop()\n    else armBlankTimer()\n  }\n\n"
        "  onFaceAuthenticatingChanged: {\n    if (!lockRequested) return\n"
        "    if (faceAuthenticating) idleBlankTimer.stop()\n    else armBlankTimer()\n  }\n\n"
        "  onFaceConfiguredChanged: syncFace()\n")

    lines = view.split("\n")
    last_import = max(i for i, l in enumerate(lines) if l.startswith("import "))
    lines.insert(last_import + 1, 'import "FaceModel.js" as FaceModel')
    view = "\n".join(lines)
    view = once(view, "  property bool fingerprintConfigured: false\n",
        "  property bool fingerprintConfigured: false\n"
        "  // What the lock offers: \"\" without a face, \"offered\", \"exhausted\" or \"expired\".\n"
        "  property string faceState: \"\"\n  property bool faceAuthenticating: false\n")
    view = once(view, '  readonly property string placeholderText: Commons.I18n.t("lock.enterPassword")\n',
        '  readonly property string placeholderText: FaceModel.placeholderText(faceState, Commons.I18n.t)\n'
        '  readonly property bool faceIconShown: faceState === "offered" || faceAuthenticating\n')
    view = once(view, "  readonly property bool showPasswordCursor: inputEnabled && !authenticatingPassword && failureMessage.length === 0\n",
        "  readonly property bool showPasswordCursor: inputEnabled && !authenticatingPassword && !faceAuthenticating && failureMessage.length === 0\n")
    view = once(view, '        text: root.authenticatingPassword ? Commons.I18n.t("lock.checking") : (root.failureMessage.length > 0 ? root.failureMessage : root.placeholderText)\n',
        '        text: root.faceAuthenticating ? Commons.I18n.t("lock.scanningFace") : root.authenticatingPassword ? Commons.I18n.t("lock.checking") : (root.failureMessage.length > 0 ? root.failureMessage : root.placeholderText)\n')
    view = sub_once(view, r"^(        color: )root\.authenticatingPassword \? ", lambda m: m.group(1) + "(root.authenticatingPassword || root.faceAuthenticating) ? ")
    view = once(view, "        font.italic: !root.authenticatingPassword && root.failureMessage.length > 0\n",
        "        font.italic: !root.authenticatingPassword && !root.faceAuthenticating && root.failureMessage.length > 0\n")
    view = sub_once(view, r"^(  readonly property real fingerprintReserve: .*\n)",
        lambda m: m.group(1) + "  readonly property real faceReserve: faceIconShown ? Math.round(faceIcon.implicitWidth + 12) : 0\n")
    assert view.count("+ root.fingerprintReserve") == 2
    view = view.replace("+ root.fingerprintReserve", "+ Math.max(root.fingerprintReserve, root.faceReserve)")
    m = re.search(r"      Text \{\n        id: fingerprintIcon\n.*?\n      \}\n", view, re.S)
    assert m
    block = m.group(0)
    color_line = re.search(r"^        color: (.*)$", block, re.M).group(1)
    placeholder = color_line.split(": ")[-1].strip()
    icon = FACE_ICON % {
        "active": placeholder.replace(".placeholder", ".text"),
        "placeholder": placeholder,
        "font_lines": "\n".join(l for l in block.split("\n") if l.strip().startswith("font.")),
    }
    view = view.replace(block, icon + block, 1)

    (dst / "Service.qml").write_text(service)
    (dst / "LockView.qml").write_text(view)
    (dst / "FaceModel.js").write_text(FACE_MODEL)


def patch_polkit(src, dst):
    agent = (src / "PolkitAgent.qml").read_text()
    model = (src / "PolkitModel.js").read_text()

    agent = once(agent, "  property bool fingerprintConfigured: false\n",
        "  property bool fingerprintConfigured: false\n"
        "  // omarchy-face-match asks first in the polkit PAM stack (a face is enrolled).\n"
        "  property bool faceConfigured: false\n"
        "  // The last answer sent was the empty consent to scan, not a password.\n"
        "  property bool scanning: false\n")
    agent = once(agent, "  readonly property bool fingerprintMode: fingerprintConfigured && !laptopClosed && dialogVisible && !responseRequired && !submitted && !errorFlash\n",
        "  readonly property bool fingerprintMode: fingerprintConfigured && !laptopClosed && dialogVisible && !responseRequired && !submitted && !errorFlash\n"
        "  // Face is offered while PAM waits for the password and the lid is open:\n"
        "  // the Copilot key starts the scan, typing takes the password path. The\n"
        "  // PAM stack itself enforces this; the dialog only says so.\n"
        "  readonly property bool faceOffered: faceConfigured && !laptopClosed && dialogVisible && responseRequired && !submitted && !errorFlash\n")
    agent = once(agent, "    fingerprintConfigured = PolkitModel.fingerprintConfiguredFromPamConfig(raw)\n",
        "    fingerprintConfigured = PolkitModel.fingerprintConfiguredFromPamConfig(raw)\n"
        "    faceConfigured = PolkitModel.faceConfiguredFromPamConfig(raw)\n")
    agent = once(agent, "    onLoadFailed: root.fingerprintConfigured = false\n",
        "    onLoadFailed: {\n      root.fingerprintConfigured = false\n      root.faceConfigured = false\n    }\n")
    agent = once(agent, "    errorFlash = false\n    submitted = false\n    passwordInput.text = \"\"\n",
        "    errorFlash = false\n    submitted = false\n    scanning = false\n    passwordInput.text = \"\"\n")
    agent = once(agent, "    submitted = true\n    errorFlash = false\n    flow.submit(passwordInput.text)\n",
        "    scanning = false\n    submitted = true\n    errorFlash = false\n    flow.submit(passwordInput.text)\n")
    agent = once(agent, "  function cancelRequest() {\n", FACE_KEY + "  function cancelRequest() {\n")
    agent = once(agent, '          text: "\\uf023"\n',
        '          text: root.faceOffered || root.scanning ? "\\uf030" : "\\uf023"\n          textFormat: Text.PlainText\n')
    agent = once(agent, '            text: root.errorFlash ? I18n.t("polkit.wrong") : (root.submitted ? I18n.t("polkit.checking") : I18n.t("polkit.enterPassword"))\n',
        '            text: root.errorFlash ? (root.scanning ? I18n.t("polkit.faceNoMatch") : I18n.t("polkit.wrong"))\n'
        '              : (root.submitted ? (root.scanning ? I18n.t("polkit.scanningFace") : I18n.t("polkit.checking"))\n'
        '              : (root.faceOffered ? I18n.t("polkit.faceOrPassword") : I18n.t("polkit.enterPassword")))\n')

    model = once(model, "function authorizationLabel(", FACE_PAM_CONFIG + "function authorizationLabel(")
    model = once(model, "    fingerprintConfiguredFromPamConfig: fingerprintConfiguredFromPamConfig,\n",
        "    fingerprintConfiguredFromPamConfig: fingerprintConfiguredFromPamConfig,\n    faceConfiguredFromPamConfig: faceConfiguredFromPamConfig,\n")

    (dst / "PolkitAgent.qml").write_text(agent)
    (dst / "PolkitModel.js").write_text(model)


def main(argv):
    if len(argv) != 3:
        print("Usage: bin/patch-shell-plugins <omarchy>/shell <output>/shell", file=sys.stderr)
        return 2
    src, dst = pathlib.Path(argv[1]), pathlib.Path(argv[2])
    for name, patch in (("lock", patch_lock), ("polkit", patch_polkit)):
        out = dst / "plugins" / name
        out.mkdir(parents=True, exist_ok=True)
        patch(src / "plugins" / name, out)
        print(f"{name}: {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
