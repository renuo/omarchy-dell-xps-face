#!/bin/bash

# omarchy:summary=Remove face authentication from sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e

lock_pam=/etc/pam.d/omarchy-lock-face
face_marker='pam_howdy[.]so|howdy/pam[.]py|omarchy-face-match'

# Resolve the invoking account before changing authentication or packages.
if (( EUID == 0 )) && [[ -v SUDO_UID ]]; then
  if [[ ! $SUDO_UID =~ ^[0-9]+$ ]]; then
    echo "Cannot identify the invoking face user" >&2
    exit 1
  fi
  face_user=$(/usr/bin/id -nu "+$SUDO_UID") || exit 1
else
  face_user=$(/usr/bin/id -un) || exit 1
fi

if [[ -z $face_user || $face_user == "." || $face_user == ".." || $face_user == */* ]]; then
  echo "Unsafe face user name" >&2
  exit 1
fi


# Drop the face module and only the clamshell gate directly above it, so a
# fingerprint stack sharing the file keeps its own gate.
remove_face_lines() {
  local file=$1 label=$2

  if [[ -f $file ]] && grep -Eq -- "$face_marker" "$file"; then
    echo "Removing face authentication from $label..."
    sudo sed -i -E \
      -e "\\%omarchy-hw-laptop-closed%{N;\\%\\n.*($face_marker)%d;P;D}" \
      -e "\\%$face_marker%d" "$file"
  fi
}

remove_lock_face_pam() {
  if [[ -f $lock_pam ]]; then
    echo "Removing lock screen face authentication..."
    sudo rm -f "$lock_pam"
  fi
}


echo -e "\e[32mRemoving face authentication.\n\e[0m"

remove_face_lines /etc/pam.d/sudo sudo
remove_face_lines /etc/pam.d/polkit-1 polkit
remove_lock_face_pam

# The face models are untracked package data, so clear them while Howdy's CLI
# is still there to do it; a failure here must not leave them behind.
if omarchy-pkg-present howdy; then
  echo "Removing $face_user's face models..."
  sudo howdy -U "$face_user" -y clear
fi

# pam-python is only on machines set up before the pam_exec helper; dropping it
# takes its Python 2 along.
echo "Removing face packages..."
omarchy-pkg-drop howdy pam-python pamtester

echo -e "\e[32mFace authentication and $face_user's local face models have been removed.\e[0m"
