#!/bin/bash

# Install what bin/check needs. Everything else the tests use ships with Omarchy.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

chmod +x "$ROOT"/bin/* "$ROOT"/install/user/first-run/*.hook "$ROOT/test/shell"

omarchy pkg add shellcheck jq

cat <<'EOF'

Ready. Next steps:
  bin/check                                  lint and run the tests
  bin/apply-to-checkout <omarchy checkout>   copy the overlay into an Omarchy checkout
  bin/run                                    walk through the manual tests on the linked checkout (README: Install)
EOF
