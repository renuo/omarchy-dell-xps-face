#!/bin/bash

# omarchy:summary=Set up face authentication with the IR camera for sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e

security_lib=/usr/lib/security
lock_pam=/etc/pam.d/omarchy-lock-face
verify_pam=/etc/pam.d/omarchy-face-verify
face_conf=/etc/omarchy/face.conf
face_marker='pam_howdy[.]so|howdy/pam[.]py|omarchy-face-match'

# Presence is not consent: a camera sees a face whether or not its owner meant
# to approve anything, unlike a finger placed on a reader. So the stable
# layout asks first. A hint line explains, then expose_authtok on the module
# line shows the usual password prompt: Enter on an empty line is the consent
# that starts the scan, a typed password skips the camera and reaches pam_unix
# through try_first_pass, and sudo -n or a script can never trigger a scan.
face_hint="auth      optional pam_exec.so quiet stdout /usr/bin/omarchy-face-match --hint"

# A clamshell gate runs before the face lines in every stack: a shut lid covers
# the camera, so it skips them (success=N) and PAM drops straight to the
# password prompt instead of waiting for Howdy to time out. pam_exec needs a
# literal absolute path, so point at the fixed /usr/bin one the omarchy package
# always provides.
face_gate_skipping() {
  echo "auth      [success=$1 default=ignore] pam_exec.so quiet /usr/bin/omarchy-hw-laptop-closed"
}

# Howdy's package layout decides the PAM module: the beta ships a native
# pam_howdy.so, which scans as soon as it runs; the stable release ships a
# pam_python script, which needs Python 2, so pam_exec runs omarchy-face-match
# around its compare.py instead (seteuid keeps root for sudo and polkit, stdout
# feeds the prompt). This is the lock screen's line, which scans without
# asking: the lock cannot answer a prompt, so it takes the consent in its view,
# Enter on the empty field.
# The package's own file list answers this even though the stable install is
# readable by root only.
face_module_line() {
  local files

  files=$(pacman -Qlq howdy) || return 1
  if grep -qxF -- "$security_lib/pam_howdy.so" <<<"$files"; then
    echo "pam_howdy.so"
  elif grep -qxF -- "$security_lib/howdy/compare.py" <<<"$files"; then
    echo "pam_exec.so seteuid quiet stdout /usr/bin/omarchy-face-match"
  else
    return 1
  fi
}

howdy_config_file() {
  local files

  files=$(pacman -Qlq howdy) || return 1
  grep -m1 -xF -- "/etc/howdy/config.ini" <<<"$files" ||
    grep -m1 -xF -- "$security_lib/howdy/config.ini" <<<"$files"
}

# The lines sudo and polkit carry for face authentication, in order: the gate,
# then for the helper the hint and the module asking first (expose_authtok),
# for the beta's native module just the module.
face_block() {
  if [[ $face_module == pam_exec.so* ]]; then
    face_gate_skipping 2
    echo "$face_hint"
    echo "auth      sufficient ${face_module%% /usr/bin/*} expose_authtok /usr/bin/omarchy-face-match"
  else
    face_gate_skipping 1
    echo "auth      sufficient $face_module"
  fi
}

# True when the file carries the block exactly: contiguous and in order. The
# block travels through the environment, where awk interprets nothing.
stack_has_block() {
  local block

  block=$(face_block)
  [[ -f $1 ]] || return 1
  BLOCK="$block" awk '
    { lines[NR] = $0 }
    END {
      n = split(ENVIRON["BLOCK"], wanted, "\n")
      for (i = 1; i + n - 1 <= NR; i++) {
        hit = 1
        for (j = 1; j <= n; j++) if (lines[i + j - 1] != wanted[j]) { hit = 0; break }
        if (hit) exit 0
      }
      exit 1
    }' "$1"
}

# Face lines go together with only the gate directly above them, so a
# fingerprint stack sharing the file keeps its own gate.
strip_face_lines() {
  sudo sed -i -E \
    -e "\\%omarchy-hw-laptop-closed%{N;\\%\\n.*($face_marker)%d;P;D}" \
    -e "\\%$face_marker%d" "$1"
}

configure_stack() {
  local file=$1 label=$2 line
  local inserts=()

  if stack_has_block "$file"; then
    return
  fi
  echo "Configuring $label for face authentication..."
  if grep -Eq -- "$face_marker" "$file"; then
    strip_face_lines "$file"
  fi
  while IFS= read -r line; do
    inserts+=(-e "1i $line")
  done < <(face_block)
  sudo sed -i "${inserts[@]}" "$file"
}

setup_pam_config() {
  configure_stack /etc/pam.d/sudo sudo

  if [[ -f /etc/pam.d/polkit-1 ]]; then
    configure_stack /etc/pam.d/polkit-1 polkit
  else
    echo "Creating polkit configuration with face authentication..."
    # omarchy:heredoc-expands paths=none -- face_block prints the literal PAM
    # lines defined above, built from the fixed /usr/bin gate and hint and
    # Howdy's package file list, shared with the sed insertions so the stacks
    # cannot drift between files.
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<EOF
$(face_block)
auth      include system-auth

account   include system-auth
password  include system-auth
session   include system-auth
EOF
  fi
}

# A stack the user left out loses the face lines an earlier run put there.
unconfigure_stack() {
  local file=$1 label=$2

  if [[ -f $file ]] && grep -Eq -- "$face_marker" "$file"; then
    echo "Removing face authentication from $label..."
    strip_face_lines "$file"
  fi
}

remove_pam_config() {
  unconfigure_stack /etc/pam.d/sudo sudo
  unconfigure_stack /etc/pam.d/polkit-1 polkit
}

setup_lock_face_pam() {
  echo "Configuring lock screen for face authentication..."
  # omarchy:heredoc-expands paths=none -- $face_module is the PAM module line
  # taken from Howdy's package file list, never from the caller.
  sudo tee "$lock_pam" >/dev/null <<EOF
#%PAM-1.0
auth       required                    $face_module
account    include                     system-local-login
EOF
}

remove_lock_face_pam() {
  if [[ -f $lock_pam ]]; then
    echo "Removing lock screen face authentication..."
    sudo rm -f "$lock_pam"
  fi
}

# Verify through PAM before touching any stack, the way they will run it.
# Enrollment only proves Howdy saw a face, not that the module can match it
# from a PAM stack. The service lives for this check alone, so a lock screen
# the user left out never offers the face, not even for a moment.
verify_face() {
  local status=0

  # omarchy:heredoc-expands paths=none -- $face_module is the PAM module line
  # taken from Howdy's package file list, never from the caller.
  sudo tee "$verify_pam" >/dev/null <<EOF
#%PAM-1.0
auth       required                    $face_module
EOF
  sudo pamtester "${verify_pam##*/}" "$USER" authenticate || status=$?
  sudo rm -f "$verify_pam"
  return "$status"
}

# How many scans one lock allows and for how long after locking, read by the
# lock screen. Written once, so a re-run keeps the user's edits.
setup_face_conf() {
  if [[ -f $face_conf ]]; then
    return
  fi
  echo "Writing the lock screen's face limits to $face_conf..."
  sudo mkdir -p "${face_conf%/*}"
  sudo tee "$face_conf" >/dev/null <<'EOF'
# Face authentication on the lock screen. Edit with sudo; the lock reads
# changes right away. Past either limit only the password unlocks.

# Face scans one lock allows.
LOCK_ATTEMPTS=1

# Minutes after locking during which the lock offers the face.
LOCK_WINDOW_MINUTES=60
EOF
}


echo -e "\e[32mSetting up face authentication with the IR camera.\n\e[0m"

# Bail before installing anything if there's no camera to talk to.
if ! omarchy-hw-dell-xps-ir-camera; then
  echo -e "\e[31mNo supported IR camera detected.\e[0m"
  exit 1
fi

if ! omarchy-hw-dell-xps-ir-camera --driver; then
  echo -e "\e[31mThe IR camera has no usable driver yet.\e[0m"
  echo "Install the hm1092-ir-camera package (omarchy pkg add hm1092-ir-camera), reboot, then run this setup again."
  exit 1
fi

if ! face_device=$(omarchy-hw-dell-xps-ir-camera --device); then
  echo -e "\e[31mThe IR camera driver is loaded, but its grayscale relay publishes no device.\e[0m"
  echo "Check 'systemctl status hm1092-relay' and run this setup again once the HM1092 IR Camera device exists."
  exit 1
fi

if [[ $face_device != /dev/video[0-9]* ]]; then
  echo -e "\e[31mUnexpected IR camera device: $face_device\e[0m"
  exit 1
fi

# Ask before the long AUR builds, so nothing waits on an answer afterwards.
scope_all="sudo, polkit and lock screen"
scope_auth="sudo and polkit only"
scope_lock="Lock screen only"
case $(gum choose "$scope_all" "$scope_auth" "$scope_lock" --header "Use your face for") in
  "$scope_all") use_auth=1 use_lock=1 ;;
  "$scope_auth") use_auth=1 use_lock=0 ;;
  "$scope_lock") use_auth=0 use_lock=1 ;;
  *) exit 1 ;;
esac

echo "Installing required packages..."
echo "Howdy and its dependencies are built from the AUR, which can take a long time;"
echo "stay nearby, pacman asks for your password only after each build finishes."
omarchy-pkg-aur-add howdy pamtester

if ! face_module=$(face_module_line); then
  echo -e "\e[31mHowdy installed no PAM module.\e[0m"
  exit 1
fi

if ! howdy_config=$(howdy_config_file); then
  echo -e "\e[31mHowdy installed no configuration file.\e[0m"
  exit 1
fi

echo "Pointing Howdy at $face_device..."
sudo sed -i "s|^device_path *=.*|device_path = $face_device|" "$howdy_config"
if ! sudo grep -qxF -- "device_path = $face_device" "$howdy_config"; then
  echo -e "\e[31mCould not set device_path in $howdy_config.\e[0m"
  exit 1
fi

# Enroll the first face model
echo -e "\e[32m\nLet's add your face. Look straight into the camera.\e[0m"
echo -e "The IR illuminator lights up while the model is captured.\n"

if ! sudo howdy add; then
  echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
  exit 1
fi

echo -e "\e[32m\nFace model added successfully!\e[0m"

echo -e "\nNow let's verify that it's working correctly. Look into the camera again.\n"

if ! verify_face; then
  echo -e "\e[31m\nVerification failed. You may want to try enrolling again.\e[0m"
  exit 1
fi

if (( use_auth )); then
  setup_pam_config
else
  remove_pam_config
fi

if (( use_lock )); then
  setup_lock_face_pam
else
  remove_lock_face_pam
fi

setup_face_conf

echo -e "\e[32m\nPerfect! Face authentication is now configured.\e[0m"
if (( use_auth )); then
  echo "sudo and polkit: press Enter on the empty password prompt to use your face."
fi
if (( use_lock )); then
  echo "Lock screen (Super + Ctrl + L): press Enter on the empty field to use your face."
  echo "How many scans a lock allows, and for how long after locking, is set in $face_conf."
fi
