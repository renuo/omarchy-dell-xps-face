#!/bin/bash

# Copy the overlay into an Omarchy checkout (github.com/omacom/omarchy) so it
# can be tested with `omarchy dev link` and sent upstream as one change.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

if (( $# != 1 )) || [[ $1 == "-h" || $1 == "--help" ]]; then
  echo "Usage: bin/apply-to-checkout <path-to-omarchy-checkout>" >&2
  exit 2
fi

checkout=$(realpath -e -- "$1")
menu="$checkout/default/omarchy/omarchy-menu.jsonc"

for required in bin/omarchy test/shell.d/base-test.sh default/omarchy/omarchy-menu.jsonc install/user/first-run default/hypr/toggles default/i18n/en/shell.json default/i18n/en/menu.json shell/plugins/lock/Service.qml shell/plugins/polkit/PolkitAgent.qml; do
  [[ -e $checkout/$required ]] || {
    echo "$checkout is not an Omarchy checkout: missing $required" >&2
    exit 1
  }
done

install -m 755 "$ROOT"/bin/omarchy-* "$checkout/bin/"
for test in "$ROOT"/test/shell.d/*-test.sh; do
  # Upstream owns the shared library, the package suite tests packaging/ and
  # the overlay- suites this overlay's own scripts, which all stay here; only the
  # checkout's own suites go across.
  [[ ${test##*/} == "base-test.sh" || ${test##*/} == hm1092-ir-camera-package-test.sh || ${test##*/} == overlay-*-test.sh ]] && continue
  install -m 644 "$test" "$checkout/test/shell.d/"
done
install -m 755 "$ROOT"/install/user/first-run/setup-face.hook "$checkout/install/user/first-run/"
# The lock's grant is installed by the setup, only for the lock screen; an
# earlier overlay shipped it under etc/, where every machine would get it.
install -D -m 644 "$ROOT"/default/sudoers.d/omarchy-face-match -t "$checkout/default/sudoers.d/"
rm -f "$checkout/etc/sudoers.d/omarchy-face-match"
install -m 644 "$ROOT"/default/hypr/toggles/face-key.lua "$checkout/default/hypr/toggles/"
# Units, PAM services and the lock's limits the setup copies into place.
install -D -m 644 "$ROOT"/default/systemd/system/omarchy-face-key.* -t "$checkout/default/systemd/system/"
install -D -m 644 "$ROOT"/default/pam.d/omarchy-* -t "$checkout/default/pam.d/"
install -m 644 "$ROOT"/default/omarchy/face.conf "$checkout/default/omarchy/"
# The lock plugin files are upstream's with the face context added, so they
# replace the checkout's copies outright; rebase them when upstream's move.
install -m 644 "$ROOT"/shell/plugins/lock/Service.qml "$ROOT"/shell/plugins/lock/LockView.qml "$ROOT"/shell/plugins/lock/FaceModel.js "$checkout/shell/plugins/lock/"
install -m 644 "$ROOT"/shell/plugins/polkit/PolkitAgent.qml "$ROOT"/shell/plugins/polkit/PolkitModel.js "$checkout/shell/plugins/polkit/"
install -D -m 644 "$ROOT/docs/face-authentication.md" "$checkout/docs/face-authentication.md"

# Each menu row goes directly under its FIDO2 sibling, once. The overlay spells
# its icon as a \u escape; upstream rows carry the glyph itself, so convert it
# here and hand awk the text through the environment, where nothing is
# interpreted. A row an earlier overlay applied goes first, so a changed row
# replaces it.
insert_after() {
  local anchor=$1 line=$2

  grep -qxF -- "$line" "$menu" && return 0
  KEY="${line%%:*}:" awk 'index($0, ENVIRON["KEY"]) != 1' "$menu" >"$menu.tmp"
  mv "$menu.tmp" "$menu"
  grep -qF -- "\"$anchor\"" "$menu" || {
    echo "$menu has no \"$anchor\" row to insert after" >&2
    exit 1
  }
  ANCHOR="\"$anchor\"" LINE="$line" awk '
    { print }
    index($0, ENVIRON["ANCHOR"]) == 3 { print ENVIRON["LINE"] }' "$menu" >"$menu.tmp"
  mv "$menu.tmp" "$menu"
}

while IFS= read -r line; do
  line=$(printf '%b' "$line")
  case "$line" in
    '  "setup.security.face"'*) insert_after setup.security.fido2 "$line" ;;
    '  "remove.security.face"'*) insert_after remove.security.fido2 "$line" ;;
  esac
done <"$ROOT/default/omarchy/omarchy-menu.jsonc"

# The face's English strings join upstream's catalogs; translations follow
# through upstream's sync. The shell catalog keeps its keys sorted, and each
# menu entry goes right after its FIDO2 sibling, as the menu rows do.
shell_catalog="$checkout/default/i18n/en/shell.json"
jq -S -s '.[0] + .[1]' "$shell_catalog" "$ROOT/default/i18n/en/shell.json" >"$shell_catalog.tmp"
mv "$shell_catalog.tmp" "$shell_catalog"
menu_catalog="$checkout/default/i18n/en/menu.json"
jq --slurpfile ours "$ROOT/default/i18n/en/menu.json" '
  reduce ($ours[0] | to_entries[]) as $entry (.;
    if has($entry.key) then .[$entry.key] = $entry.value
    else (keys_unsorted | index($entry.key | sub("\\.face$"; ".fido2"))) as $at
      | if $at == null then error("no FIDO2 sibling for " + $entry.key) else . end
      | to_entries | .[: $at + 1] + [$entry] + .[$at + 1:] | from_entries
    end)' "$menu_catalog" >"$menu_catalog.tmp"
mv "$menu_catalog.tmp" "$menu_catalog"

# The setup installs the driver now; an earlier overlay installed it on every
# matching machine through a hardware leaf, so take that back out.
all_sh="$checkout/install/hardware/all.sh"
# shellcheck disable=SC2016 # literal text for all.sh
ir_line='run_logged "$OMARCHY_INSTALL/hardware/intel/ipu7-ir-camera.sh"'
if [[ -f $all_sh ]] && grep -qxF -- "$ir_line" "$all_sh"; then
  IR="$ir_line" awk '$0 != ENVIRON["IR"]' "$all_sh" >"$all_sh.tmp"
  mv "$all_sh.tmp" "$all_sh"
fi
rm -f "$checkout/install/hardware/intel/ipu7-ir-camera.sh" "$checkout/test/shell.d/ipu7-ir-camera-install-test.sh"

echo "Applied to $checkout. Run I18N_STRUCTURAL=1 ./test/shell there, then omarchy dev pkg-test and omarchy dev link $checkout."
echo "The driver package itself lives in packaging/hm1092-ir-camera and is not part of the checkout."
